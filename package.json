{
  "name": "open-cells-academy-cli",
  "version": "0.1.0",
  "description": "Educational OpenCells CLI for creating runnable applications and Lit components.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PixelDroid19/open-cells-academy-cli.git"
  },
  "homepage": "https://github.com/PixelDroid19/open-cells-academy-cli#readme",
  "bugs": {
    "url": "https://github.com/PixelDroid19/open-cells-academy-cli/issues"
  },
  "keywords": [
    "open-cells",
    "cells",
    "lit",
    "web-components",
    "scaffolding",
    "education"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "scripts": {
    "verify:release": "node --test --test-concurrency=1 test/security/public-release.test.js test/security/release-gates.test.js",
    "prepack": "npm run verify:release"
  },
  "bin": {
    "cells": "bin/cells.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "package-self-manifest.json"
  ],
  "dependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@html-eslint/eslint-plugin": "0.64.0",
    "@web/test-runner": "0.19.0",
    "@web/test-runner-junit-reporter": "0.8.0",
    "@web/test-runner-playwright": "0.11.0",
    "es-module-lexer": "1.7.0",
    "eslint": "9.39.4",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-lit-a11y": "5.1.1",
    "eslint-plugin-wc": "3.1.0",
    "lit": "3.3.3",
    "sass": "1.102.0",
    "vite": "7.3.6",
    "vitest": "3.2.4",
    "workbox-build": "7.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@open-cells/core": "^1.2.1",
    "@open-cells/page-mixin": "^1.2.4",
    "@open-wc/scoped-elements": "3.0.10",
    "@vitest/coverage-v8": "3.2.4",
    "@webcomponents/scoped-custom-element-registry": "0.0.10",
    "happy-dom": "20.11.2"
  },
  "overrides": {
    "glob": "13.0.6",
    "magic-string": "0.30.21"
  }
}
